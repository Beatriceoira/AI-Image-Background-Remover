*.swp
*.swo
*~

# Model weights and large data files
*.pth
*.pt
*.onnx
*.safetensors

# Uploads and outputs (temporary files)
uploads/*
outputs/

# Ignore generated files
uploads/*
outputs/*
backend/app/models/weights/*

# Keep directory placeholders
!uploads/.gitkeep
!outputs/.gitkeep
!backend/app/models/weights/.gitkeep

# Environment variables (if you have a .env file for local development)
#   We already have .env.example, so we ignore .env
.env
.env.*
!env.example

# Docker
#   If you have a docker-compose.override.yml for local development, ignore it
docker-compose.override.yml